# Copy to server/.env and fill in. Never commit the real .env.
#
# Postgres connection string.
#   local:    postgres://USER:PASSWORD@localhost:5432/ai_expense
#   Neon:     postgres://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#   Supabase: postgres://postgres.PROJECT:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Set to "true" when your provider requires TLS (Neon, Supabase, Heroku, RDS).
# Most hosted Postgres needs this; a local Postgres does not.
DATABASE_SSL=false

PORT=4000

# Comma-separated origins allowed to call this API.
# 3000 is the Vite dev server port configured in vite.config.ts;
# reactjs.vakhim-dev.site is the deployed frontend (see Jenkinsfile).
CORS_ORIGINS=http://localhost:3000,https://reactjs.vakhim-dev.site

# ---------------------------------------------------------------------------
# Security / session settings (all optional — defaults are the safe ones)
# See the Environment table in server/README.md for the full description.
# ---------------------------------------------------------------------------

# Exact frontend origins, comma-separated. CANNOT be "*" — the API sends cookies.
# CORS_ORIGINS=http://localhost:3000

# Set to the number of reverse proxies in front of this process (nginx => 1).
# Leave unset when nothing proxies it: trusting X-Forwarded-For without a proxy
# lets any client forge an address and bypass the rate limiter.
# TRUST_PROXY=1

# Session cookie. COOKIE_SECURE defaults to true when NODE_ENV=production and
# must be false only for plain-HTTP localhost. SAMESITE=none forces SECURE=true.
# SESSION_TTL_HOURS=336
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# Set false to close sign-up once the accounts exist.
# ALLOW_REGISTRATION=true

# Rate limits.
# RATE_LIMIT_WINDOW_MINUTES=15
# RATE_LIMIT_API_MAX=600
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_AUTH_ACCOUNT_MAX=10
